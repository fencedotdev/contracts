# Custom git-secrets patterns for fencedotdev repos, on top of the AWS defaults
# (`git secrets --register-aws`). Register with:
#   while read -r p; do [ -n "$p" ] && [[ "$p" != \#* ]] && git secrets --add "$p"; done < .git-secrets-patterns
# See CONTRIBUTING.md for the full local setup.

# Stripe
sk_live_[0-9a-zA-Z]{24,}
rk_live_[0-9a-zA-Z]{24,}
whsec_[0-9a-zA-Z]{32,}

# Supabase
sb_secret_[0-9a-zA-Z_-]{20,}
eyJhbGciOiJIUzI1NiI[0-9a-zA-Z._-]{40,}

# Generic private key blocks
-----BEGIN (RSA |EC |OPENSSH |)PRIVATE KEY-----

# GCP KMS / service-account JSON
"type": "service_account"

# Generic high-entropy bearer/secret assignment (catches most vendor API keys)
(?i)(api[_-]?key|secret|token)['\"]?\s*[:=]\s*['\"][0-9a-zA-Z_-]{20,}['\"]
